# Shared admin password (also the demo default when unset)
ADMIN_PASSWORD=demo2010

# Vercel Blob — durable event store (claims + admin config)
# Set automatically when you connect the Blob store to the project:
#   vercel storage create women-game-event --type blob --access private
#   vercel storage connect women-game-event --yes
#   vercel storage update women-game-event --auth token --add-rw-token --yes
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
